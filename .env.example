# ── Django (partilhado por todos os serviços) ─────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

# ── JWT (mesma chave em todos — todos validam tokens emitidos pelo auth-service) ──
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── PostgreSQL — credenciais partilhadas ──────────────────────────────────
# DB_HOST e DB_NAME são injetados por serviço no docker-compose.yml
DB_USER=postgres
DB_PASSWORD=postgres
DB_PORT=5432

# ── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ── CORS ──────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Docker Compose ────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ldsgrupo1
NGINX_PORT=80

# ── Variáveis geridas pelo CI (não colocar aqui) ──────────────────────────
# IMAGE_TAG     → definido em .gitlab-ci.yml como $CI_COMMIT_SHA
# CI_REGISTRY_IMAGE → definido automaticamente pelo GitLab
